# bytes live in the shared store, not in git (chora law 1)
data
.DS_Store
**/.DS_Store

# environments
.venv/
__pycache__/
*.pyc

# run outputs (manifest-hashed before mirroring to chora/artifacts/)
runs/
*.pth
*.pt

# rendered Quarto site; the publication lives on the gh-pages branch,
# but the letters and the pre-registration keep their docs/ home on main
docs/*
!docs/LETTERS
!docs/PREREG.md
.gh-pages-worktree/

/.quarto/
**/*.quarto_ipynb
